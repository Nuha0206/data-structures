#include <stdio.h>
#include <stdlib.h>

struct tree
{
    int info;
    struct tree *leftchild;
    struct tree *rightchild;
};

typedef struct tree *NODE;
NODE root = NULL;
int count = 0;

/* Insert the elements into BST ... BST construction */
void insert()
{
    NODE temp;
    NODE current;
    NODE parent;
    int ele;
    temp = (NODE)malloc(sizeof(struct tree));
    if (temp == NULL)
    {
        printf("\n Unable to allocate memory...\n");
        return;
    }
    printf("\nEnter an element to be inserted: ");
    scanf("%d", &ele);
    temp->info = ele;
    temp->leftchild = NULL;
    temp->rightchild = NULL;
    if (root == NULL)
    {
        root = temp;
    }
    else
    {
        current = root;
        parent = NULL;
        while (current != NULL)
        {
            parent = current;
            if (ele < parent->info)
                current = current->leftchild;
            else
                current = current->rightchild;
        }
        if (ele < parent->info)
            parent->leftchild = temp;
        else
            parent->rightchild = temp;
    }
}

// Preorder tree traversal - [NLR]
void preorder(NODE root)
{
    if (root == NULL)
        return;
    printf("%d ", root->info);
    preorder(root->leftchild);
    preorder(root->rightchild);
}

// Inorder tree traversal - [LNR]
void inorder(NODE root)
{
    if (root == NULL)
        return;
    inorder(root->leftchild);
    printf("%d ", root->info);
    inorder(root->rightchild);
}

// Postorder tree traversal - [LRN]
void postorder(NODE root)
{
    if (root == NULL)
        return;
    postorder(root->leftchild);
    postorder(root->rightchild);
    printf("%d ", root->info);
}

/* Search key in the tree ...*/
void searchKey()
{
    NODE current;
    int key;
    if (root == NULL)
    {
        printf("\n Tree doesnt exist, create the tree prior to search...\n");
        return;
    }
    printf("\nEnter the key to be searched: ");
    scanf("%d", &key);
    current = root;
    while (current != NULL)
    {
        if (key == current->info)
        {
            printf("\nSucessful search , Key found...\n");
            return; // Use return instead of break to exit properly
        }
        else if (key < current->info)
            current = current->leftchild;
        else
            current = current->rightchild;
    }
    printf("\n Unsuccessful search , key not found...\n");
}

void maximum()
{
    NODE current;
    if (root == NULL)
        printf("\nTree doesnt exist...\n");
    else
    {
        current = root;
        while (current->rightchild != NULL)
            current = current->rightchild;
        printf("\nHighest element in the tree is %d", current->info);
    }
}

void minimum()
{
    NODE current;
    if (root == NULL)
        printf("\nTree doesnt exist...\n");
    else
    {
        current = root;
        while (current->leftchild != NULL)
            current = current->leftchild;
        printf("\nLeast element in the tree is %d", current->info);
    }
}

int max(int a, int b)
{
    return (a > b) ? a : b;
}

int height(NODE root)
{
    if (root == NULL)
        return -1;
    else
        return 1 + max(height(root->leftchild), height(root->rightchild));
}

void countnode(NODE root)
{
    if (root == NULL)
        return;
    countnode(root->leftchild);
    count++;
    countnode(root->rightchild);
}

void countleaf(NODE root)
{
    if (root == NULL)
        return;
    countleaf(root->leftchild);
    if (root->leftchild == NULL && root->rightchild == NULL)
        count++;
    countleaf(root->rightchild);
}

/* Delete Key Function - Fixed Logic */
void deleteKey()
{
    int key;
    NODE current, parent, suc, q;
    if (root == NULL)
    {
        printf("\nTree doesnt exist...");
        return;
    }
    printf("\nEnter the key to be deleted: ");
    scanf("%d", &key);
    parent = NULL;
    current = root;
    while (current != NULL && current->info != key)
    {
        parent = current;
        if (key < current->info)
            current = current->leftchild;
        else
            current = current->rightchild;
    }
    if (current == NULL)
    {
        printf("\nKey not found..\n");
        return;
    }

    // Case 1 & 2: Node has 0 or 1 child
    if (current->leftchild == NULL)
        q = current->rightchild;
    else if (current->rightchild == NULL)
        q = current->leftchild;
    // Case 3: Node has 2 children
    else
    {
        suc = current->rightchild;
        while (suc->leftchild != NULL)
            suc = suc->leftchild;
        suc->leftchild = current->leftchild;
        q = current->rightchild;
    }

    if (parent == NULL)
        root = q;
    else if (current == parent->leftchild)
        parent->leftchild = q;
    else
        parent->rightchild = q;

    printf("\n Key = %d will be deleted now...\n", current->info);
    free(current);
}

void display(NODE root, int level)
{
    int i;
    if (root == NULL)
        return;
    display(root->rightchild, level + 1);
    for (i = 0; i < level; i++)
        printf("    "); // Increased spacing for visibility
    printf("%d\n", root->info);
    display(root->leftchild, level + 1);
}

